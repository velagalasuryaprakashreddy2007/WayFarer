<% layout("/layouts/boilerplate") %>
<!--<h3>All Listings</h3> -->

<style>
  #filters{
    display:flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 1.5rem;
    padding: 1rem 0;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  #filters::-webkit-scrollbar{
    display: none;
  }
  .filter{
    text-align:center;
    flex-shrink: 0;
    opacity:0.7;
  }
  .filter:hover{
    opacity:1;
    cursor:pointer;
  }
  .filter p{
    font-size:0.8rem;
    margin-top: 0.3rem;
    white-space: nowrap;
  }
  @media (min-width: 768px){
    #filters{
      flex-wrap: wrap;
      overflow-x: visible;
      justify-content: center;
      gap: 2rem;
    }
  .tax-info{
    display:none;
  }
  .tax-toggle{
    border : 1px solid black;
    padding:1rem;
    height: 3.25rem;
    border-radius: 1rem;
    margin-left: 2rem;
    display:flex;
    align-items:center;

  }
  }
  </style>
<div id="filters">
  <a class="filter" href="/listings/icon/trending">
     <div><i class="fa-solid fa-fire"></i> </div>
      <p>Trending</p>
  </a>
  <a class="filter" href="/listings/icon/rooms">
     <div><i class="fa-solid fa-bed"></i> </div>
      <p>Rooms</p>
  </a>
  <a class="filter" href="/listings/icon/mountains">
     <div><i class="fa-solid fa-mountain"></i></i> </div>
      <p>Mountains</p>
  </a>
  <a class="filter" href="/listings/icon/cities">
     <div><i class="fa-solid fa-city"></i> </div>
      <p>Cities</p>
  </a>
  <a class="filter" href="/listings/icon/houses">
     <div><i class="fa-solid fa-house"></i> </div>
      <p>Houses</p>
  </a>
  <a class="filter" href="/listings/icon/castles">
     <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
  </a>
   <a class="filter" href="/listings/icon/pools">
     <div> <i class="fa-solid fa-person-swimming"></i> </div>
      <p>Pools</p>
  </a>
  <a class="filter" href="/listings/icon/farms">
     <div><i class="fa-solid fa-tractor"></i> </div>
      <p>Farms</p>
  </a>
  <a class="filter" href="/listings/icon/camping">
     <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
  </a>
  <a class="filter" href="/listings/icon/arctic">
     <div><i class="fa-solid fa-igloo"></i></div>
      <p>Arctic</p>
  </a>
   <a class="filter" href="/listings/icon/islands">
     <div> <i class="fa-solid fa-tree"></i></div>
      <p>Islands</p>
  </a>
  <a class="filter" href="/listings/icon/ships">
     <div>  <i class="fa-solid fa-ship"></i></div>
      <p>Ships</p>
  </a>
  

  <div class="tax-toggle">
  <div class="form-check-reverse form-switch">
  <input class="form-check-input" 
    type="checkbox" 
    role="switch"
    id="switchCheckDefault">
  <label class="form-check-label" 
  for="switchCheckDefault">
  Display Tax Information </label>
</div>
</div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem" />

        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br />
            <% if (listing.price != null) { %>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
              <i class="tax-info" > &nbsp; &nbsp; +10% GST</i>
            <% } else { %>
              Price not set
            <% } %>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<!--
<form method="GET" action="/listings/new">
  <button>Add new Listing</button>
</form>
-->
<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      if(info.style.display == "inline") info.style.display = "none";
      else
      info.style.display = "inline";
    }
  })
</script>