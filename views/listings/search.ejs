<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h2 class="mb-1">Search Results</h2>
      <% if (query) { %>
        <p class="text-muted mb-0">Showing listings matching "<%= query %>".</p>
      <% } else { %>
        <p class="text-muted mb-0">Enter a title, location, or country to find homes.</p>
      <% } %>
    </div>
    <a class="btn btn-outline-dark" href="/listings">Browse all listings</a>
  </div>

  <% if (results.length === 0) { %>
    <div class="alert alert-warning" role="alert">
      No listings matched your search. Try another title, location, or country.
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for (let listing of results) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem" />
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b><br />
                <%= listing.location %>, <%= listing.country %><br />
                <% if (listing.price != null) { %>
                  &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                <% } else { %>
                  Price not set
                <% } %>
              </p>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>
</div>